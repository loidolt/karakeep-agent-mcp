# --- Karakeep ---------------------------------------------------------------
KARAKEEP_URL=https://keep.example.com
KARAKEEP_API_KEY=            # Karakeep Settings -> API Keys; the agent acts as this user
#KARAKEEP_PUBLIC_URL=        # base for links shown to users, if KARAKEEP_URL is internal
#KARAKEEP_TIMEOUT=30
#KARAKEEP_VERIFY_TLS=true

# --- Server -----------------------------------------------------------------
#KARAKEEP_MCP_READ_ONLY=false
#KARAKEEP_MCP_TRANSPORT=http   # image default; stdio when run from a shell
#KARAKEEP_MCP_HOST=0.0.0.0     # image default
#KARAKEEP_MCP_PORT=8000
#KARAKEEP_MCP_PATH=/mcp
#KARAKEEP_MCP_STATELESS_HTTP=false
#KARAKEEP_MCP_LOG_LEVEL=INFO

# --- Inbound auth: none | bearer | oidc --------------------------------------
KARAKEEP_MCP_AUTH_MODE=bearer
KARAKEEP_MCP_BEARER_TOKENS=    # comma-separated; generate with: openssl rand -hex 32

# oidc mode (OAuth clients). Provider redirect URI: <KARAKEEP_MCP_BASE_URL>/auth/callback
#KARAKEEP_MCP_AUTH_MODE=oidc
#KARAKEEP_MCP_BASE_URL=https://keep-mcp.example.com
#KARAKEEP_MCP_OIDC_ISSUER=https://id.example.com
#KARAKEEP_MCP_OIDC_CLIENT_ID=
#KARAKEEP_MCP_OIDC_CLIENT_SECRET=
#KARAKEEP_MCP_OIDC_ALGORITHM=RS256 # match the upstream client's JWT signing algorithm
#KARAKEEP_MCP_OIDC_VERIFY_ID_TOKEN=true
#KARAKEEP_MCP_OIDC_SCOPES=openid,profile,email # add offline_access if the provider requires it
#KARAKEEP_MCP_OIDC_FORWARD_RESOURCE=false  # true only if the provider needs RFC 8707 resource
#KARAKEEP_MCP_JWT_SIGNING_KEY= # optional; openssl rand -hex 32
#KARAKEEP_MCP_STATE_DIR=/data  # image default; mount a volume here

# oidc mode, one Karakeep account per person instead of KARAKEEP_API_KEY:
# <OIDC subject>=<that person's Karakeep API key>, comma-separated, or one per line in a file
#KARAKEEP_MCP_USER_KEYS=
#KARAKEEP_MCP_USER_KEYS_FILE=/run/secrets/karakeep-user-keys
